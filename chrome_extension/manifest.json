{
  "manifest_version": 3,
  "name": "AutoRIS - Medical Dictation & PACS Translator",
  "version": "1.1.0",
  "author": "AutoRIS Team",
  "description": "Tự động điền Mô tả & Kết luận vào RIS từ điện thoại (AutoRIS ASR) và Dịch Lung-RADS CT Ngực từ PACS (F9)",
  "permissions": [
    "storage",
    "clipboardWrite",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "http://192.168.50.105/*",
    "https://pacs.benhviendaihocyhanoi.com/*",
    "http://192.168.50.110:30979/*",
    "https://autoris.hoang.qzz.io/*",
    "https://9router.hoang.qzz.io/*",
    "https://generativelanguage.googleapis.com/*",
    "http://192.168.50.100:8080/*",
    "http://localhost:8080/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AutoRIS - Cài đặt Dictation vào RIS & PACS"
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://192.168.50.105/*",
        "https://pacs.benhviendaihocyhanoi.com/*",
        "http://192.168.50.110:30979/*",
        "http://*/*ris/study/reading*",
        "https://*/*ris/study/reading*",
        "http://*/*study/reading*",
        "https://*/*study/reading*",
        "http://*/ris/*",
        "https://*/ris/*",
        "http://*/RIS/*",
        "https://*/RIS/*"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "js": [
        "defaults.js",
        "clinical_synthesizer.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
