{
  "manifest_version": 3,
  "name": "AutoRIS - Multi-Modality Medical Secretary & PACS Translator",
  "version": "2.0.1",
  "author": "AutoRIS Team",
  "description": "Thư ký Y khoa Trí tuệ Nhân tạo Đa Phương tiện (Siêu âm, CT, MRI, X-quang) & Bộ Gác cổng An toàn Lâm sàng 2.0",
  "permissions": [
    "storage",
    "clipboardWrite",
    "tabs",
    "activeTab",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "http://192.168.50.105/*",
    "https://pacs.benhviendaihocyhanoi.com/*",
    "http://192.168.50.110:30979/*",
    "https://autoris.hoang.qzz.io/*",
    "https://9router.hoang.qzz.io/*",
    "https://generativelanguage.googleapis.com/*",
    "http://192.168.50.100:8080/*",
    "http://localhost:8080/*",
    "http://*:8000/*",
    "http://*:8080/*",
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AutoRIS - Cài đặt Dictation vào RIS & PACS"
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://192.168.50.105/*",
        "https://pacs.benhviendaihocyhanoi.com/*",
        "http://192.168.50.110:30979/*",
        "http://*/*ris/study/reading*",
        "https://*/*ris/study/reading*",
        "http://*/*study/reading*",
        "https://*/*study/reading*",
        "http://*/ris/*",
        "https://*/ris/*",
        "http://*/RIS/*",
        "https://*/RIS/*"
      ],
      "exclude_matches": [
        "http://192.168.50.105/ris/vrViewer*",
        "http://192.168.50.105/ris/vrviewer*",
        "http://*/*vrViewer*",
        "http://*/*vrviewer*",
        "https://*/*vrViewer*",
        "https://*/*vrviewer*"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "js": [
        "defaults.js",
        "clinical_synthesizer.js",
        "clinical_safety_guard.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "sandbox": {
    "pages": ["sandbox.html"]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sandbox.html",
        "sandbox.js",
        "clinical_synthesizer.js",
        "clinical_safety_guard.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
